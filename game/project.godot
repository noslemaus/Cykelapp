; Engine configuration file.
config_version=5

[application]

config/name="Cykelapp"
config/icon="res://ikon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Settings="*res://core/settings.gd"
Progress="*res://core/progress.gd"
Ride="*res://core/ride.gd"
Strava="*res://core/strava.gd"
Controls="*res://core/controls.gd"
Musik="*res://core/musik.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[shader_globals]

snow_amount={
"type": "float",
"value": 0.0
}
autumn_amount={
"type": "float",
"value": 0.0
}
wet_amount={
"type": "float",
"value": 0.0
}
ice_amount={
"type": "float",
"value": 0.0
}

[internationalization]

locale/translations=PackedStringArray("res://lang/texter.en.translation", "res://lang/texter.sv.translation", "res://lang/pass.en.translation", "res://lang/pass.sv.translation", "res://lang/planer.en.translation", "res://lang/planer.sv.translation")
locale/fallback="en"
